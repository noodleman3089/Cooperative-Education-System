{
  "compilerOptions": {
    "target": "ES2022",
    // node16 = ปล่อย CommonJS ตามที่ package.json บอก (ไม่มี "type": "module")
    // แต่ตรวจการ import ตามกฎจริงของ Node — ซึ่งจับได้ว่า puppeteer เป็น ESM ล้วน
    // และ dynamic import ที่เป็น relative path ต้องมีนามสกุล .js
    "module": "node16",
    "lib": ["ES2022"],
    "allowJs": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
