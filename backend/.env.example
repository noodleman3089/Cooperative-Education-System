PORT=5000
FRONTEND_URL=http://localhost:5173
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_DATABASE=coop_edu_db
JWT_SECRET=<generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))">
JWT_EXPIRES_IN=24h
ALLOWED_SSO_DOMAIN=rmutto.ac.th

# Number of reverse-proxy hops in front of the app (e.g. 1 for a single nginx).
# Leave unset when the app is exposed directly. Required for correct per-IP rate
# limiting and audit-log IP addresses behind a proxy.
TRUST_PROXY=

# Dev-only flags
ALLOW_SIMULATED_SSO=false
ENABLE_TEST_ROUTES=false

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Google Maps API Configuration
GOOGLE_MAPS_API_KEY=

# Google SSO
GOOGLE_CLIENT_ID=

# DocuSign Configurations (Demo Account)
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_PRIVATE_KEY=
DOCUSIGN_API_BASE_PATH=https://demo.docusign.net/restapi
DOCUSIGN_RETURN_URL=http://localhost:5000/api/documents/signing-complete
