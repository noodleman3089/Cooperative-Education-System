# development | production
#
# ตั้งเป็น production บนเครื่องจริงเสมอ ค่านี้คุม 3 อย่างพร้อมกัน:
#   1. session cookie ได้ธง Secure (SEC-08 พึ่งค่านี้โดยตรง)
#   2. rate limit เข้มขึ้น 100 เท่า (/api/auth 1,000 -> 10 ครั้งต่อ 15 นาที)
#   3. เซิร์ฟเวอร์ปฏิเสธการสตาร์ทถ้าเจอค่าของ dev ติดมาด้วย (src/config/validateEnv.ts)
NODE_ENV=development

PORT=5000
# ต้องเป็น https บน production ไม่งั้นเบราว์เซอร์จะไม่ส่ง cookie ที่ตั้ง Secure กลับมา
FRONTEND_URL=http://localhost:5173
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_DATABASE=coop_edu_db
JWT_SECRET=<generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))">
JWT_EXPIRES_IN=24h
ALLOWED_SSO_DOMAIN=rmutto.ac.th

# Number of reverse-proxy hops in front of the app (e.g. 1 for a single nginx).
# Leave unset when the app is exposed directly. Required for correct per-IP rate
# limiting and audit-log IP addresses behind a proxy.
TRUST_PROXY=

# Dev-only flags — เซิร์ฟเวอร์จะ "ไม่สตาร์ท" ถ้าค่าใดเป็น true ตอน NODE_ENV=production
# ALLOW_SIMULATED_SSO=true แปลว่าใครก็ส่ง simulated_token_for_<อีเมล> เข้ามาแล้ว
# กลายเป็นเจ้าของอีเมลนั้นได้ทันที โดยไม่ต้องมีบัญชี Google
ALLOW_SIMULATED_SSO=false
ENABLE_TEST_ROUTES=false
# MAIL_DRY_RUN=true = ไม่ส่งอีเมลออกเน็ตเลย (ใช้กับ E2E) แต่ระบบยังตอบว่าส่งสำเร็จ — production ห้ามเปิด
# MAIL_DRY_RUN=false

# เตือนพี่เลี้ยงอัตโนมัติ (เฟส 3) — ปิดเป็นค่าเริ่มต้น · true = ระบบส่งอีเมลเตือนพี่เลี้ยงที่มีงานค้างเกิน 5 วันเอง
# (จันทร์-ศุกร์ 09:00-17:59 เวลาไทย · ห่างกัน 7 วัน · ไม่เกิน 4 ครั้งต่อรอบ) และส่งสรุปพี่เลี้ยงที่เงียบให้เจ้าหน้าที่ทุกสัปดาห์
# ⚠️ เครื่อง dev ที่ใช้ SMTP จริง (Gmail) อย่าเปิด ไม่งั้นพี่เลี้ยงจริงในฐานข้อมูลจะได้รับอีเมล
MENTOR_AUTO_REMIND=false

# SEC-12: กุญแจเข้ารหัสข้อมูลอ่อนไหวของ สหกิจ 03 (เลขบัตรประชาชน/เชื้อชาติ/ศาสนา)
# ต้องเป็นเลขฐานสิบหก 64 ตัวอักษร (256 บิต) — ห้ามใช้ค่าเดียวกับเครื่อง dev บนของจริง
# สร้างด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SENSITIVE_DATA_ENCRYPTION_KEY=<generate with the command above>

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ปิด sandbox ของ Chrome ตอนสร้าง PDF — ตั้ง true เฉพาะใน container ที่ไม่มี SYS_ADMIN
# ซึ่งเป็นที่เดียวที่ sandbox เปิดไม่ได้จริง · true บนเครื่องปกติ = ยกชั้นกันของ Chrome ทิ้งฟรีๆ
PUPPETEER_NO_SANDBOX=false

# Google Maps API Configuration
GOOGLE_MAPS_API_KEY=

# Google SSO
GOOGLE_CLIENT_ID=

# DocuSign Configurations (Demo Account)
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_PRIVATE_KEY=
DOCUSIGN_API_BASE_PATH=https://demo.docusign.net/restapi
DOCUSIGN_RETURN_URL=http://localhost:5000/api/documents/signing-complete
