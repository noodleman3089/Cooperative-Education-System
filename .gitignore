# Signature images — these stamp official university documents and must never
# be committed. db:setup regenerates a placeholder for local development.
backend/secure_private/signatures/*
!backend/secure_private/signatures/.gitkeep

# Backend uploads & generated documents
# ⛔ ครอบทั้งโฟลเดอร์โดยตั้งใจ — ของเดิมระบุทีละโฟลเดอร์ย่อย พอ multer เพิ่มปลายทางใหม่
# (request_forms เมื่อ 2026-08-26) ไฟล์ที่ผู้ใช้อัปโหลดก็หลุดเข้า git ทันทีโดยไม่มีใครรู้
backend/uploads/
backend/secure_private/documents/*

# Test artifacts (generated by Playwright runs)
e2e/test-results/
e2e/playwright-report/

# Agent configuration
.agents

